# Root development reference.
# Copy relevant values into apps/api/.env after Laravel bootstrap.

APP_ENV=local

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aurevia_health
DB_USERNAME=aurevia_health
DB_PASSWORD=change-me-local-only

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

API_URL=http://127.0.0.1:8000
WEB_URL=http://localhost:4200
