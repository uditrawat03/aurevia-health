APP_NAME="Aurevia Health"
AUREVIA_VERSION=1.0.0-rc.1
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aurevia.example.com
FRONTEND_URL=https://aurevia.example.com

# Comma-separated proxy IPs/CIDRs. Leave empty when Laravel receives TLS directly.
# Example: TRUSTED_PROXIES=10.0.0.0/8,192.0.2.10
TRUSTED_PROXIES=
# Comma-separated regular expressions accepted by Laravel TrustHosts.
TRUSTED_HOSTS=^aurevia\.example\.com$

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

LIGHTHOUSE_MAX_QUERY_COMPLEXITY=500
LIGHTHOUSE_MAX_QUERY_DEPTH=12
LIGHTHOUSE_SECURITY_DISABLE_INTROSPECTION=true
LIGHTHOUSE_QUERY_CACHE_ENABLE=true
LIGHTHOUSE_QUERY_CACHE_MODE=opcache

DB_CONNECTION=pgsql
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_DATABASE=aurevia_health
DB_USERNAME=aurevia_health
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=aurevia.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=aurevia.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis.example.internal
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.internal
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@aurevia.example.com"
MAIL_FROM_NAME="${APP_NAME}"
